<?xml version="1.0" encoding="UTF-8"?>
<!-- Containers log to stdout; CloudWatch (or whatever collects stdout) keeps them. -->
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="WARN">
        <appender-ref ref="STDOUT" />
    </root>

    <logger name="dev.keyvector" level="${KEYVECTOR_LOG_LEVEL:-INFO}" />
    <logger name="software.amazon.kinesis" level="WARN" />
    <logger name="software.amazon.awssdk" level="WARN" />
    <logger name="com.datastax.oss.driver" level="WARN" />
</configuration>
